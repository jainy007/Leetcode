# QNX Neutrino / QNX OS for Safety 8.x on aarch64 (NVIDIA DRIVE OS QNX, Snapdragon Ride).
# Requires QNX_HOST and QNX_TARGET from the QNX SDP environment script.
set(CMAKE_SYSTEM_NAME QNX)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER qcc)
set(CMAKE_CXX_COMPILER q++)
set(CMAKE_C_COMPILER_TARGET gcc_ntoaarch64le)
set(CMAKE_CXX_COMPILER_TARGET gcc_ntoaarch64le_cxx)
set(CMAKE_SYSROOT $ENV{QNX_TARGET})
set(EA_OSAL "qnx" CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
