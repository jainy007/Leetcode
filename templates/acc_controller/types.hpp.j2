#pragma once

#include <cstddef>
#include <cstdint>

namespace {{ ns }} {

// Controller modes. The numeric codes are part of the CAN interface (status signal).
enum class Mode : std::uint8_t {
{% for m in modes %}
    k{{ m | camel }} = {{ loop.index0 }}U,
{% endfor %}
};
const char* to_string(Mode m) noexcept;
{% for m in messages %}

// Message {{ m.name }} (CAN id {{ m.can_id | cpp_hex }}, {{ m.payload_length }} bytes). Source: {{ m.source }}
struct {{ m.name }} {
{% for s in m.signals %}
    double {{ s.name }};  // [{{ s.min }}, {{ s.max }}] {{ s.unit }}
{% endfor %}
};
{% endfor %}

}  // namespace {{ ns }}
