add_library({{ inc }} STATIC
    src/{{ snake }}.cpp
    src/{{ snake }}_logic.cpp
    src/{{ snake }}_codec.cpp)
target_include_directories({{ inc }} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_link_libraries({{ inc }} PUBLIC ea::runtime PRIVATE ea::profile_{{ component.profile }})

if(EA_BUILD_TESTS)
    ea_add_gtest({{ inc }}_sil
        SOURCES sil/{{ snake }}_sil_test.cpp
        LIBS {{ inc }} ea::plant)
    target_include_directories({{ inc }}_sil PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
    ea_add_gtest({{ inc }}_codec_test
        SOURCES sil/{{ snake }}_codec_test.cpp sil/{{ snake }}_component_test.cpp
        LIBS {{ inc }})
endif()
