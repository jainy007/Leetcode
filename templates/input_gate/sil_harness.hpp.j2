inline ea::Result<void> encode_{{ input.snake }}_unchecked(const {{ input.name }}& in, ea::ByteSpan payload) noexcept {
    if (payload.size() != k{{ input.name }}PayloadLength) {
        return ea::ErrorCode::kLengthMismatch;
    }
{% for s in input.signals %}
{{ m.encode_signal(s, 'in', s.raw_type_min, s.raw_type_max, 'k' ~ input.name ~ 'PayloadLength') }}
{%- endfor %}
