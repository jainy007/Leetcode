{% import "input_gate/_macros.j2" as m %}
#include "{{ inc }}/{{ snake }}_codec.hpp"

#include <cmath>

#include "ea/codec/bits.hpp"

namespace {{ ns }} {
{% for msg in messages %}

ea::Result<{{ msg.name }}> decode_{{ msg.snake }}(ea::ConstByteSpan payload) noexcept {
    if (payload.size() != k{{ msg.name }}PayloadLength) {
        return ea::ErrorCode::kLengthMismatch;
    }
    {{ msg.name }} out{};
{% for s in msg.signals %}
{{ m.decode_signal(s, 'out') }}
{%- endfor %}
    return out;
}

ea::Result<void> encode_{{ msg.snake }}(const {{ msg.name }}& in, ea::ByteSpan payload) noexcept {
    if (payload.size() != k{{ msg.name }}PayloadLength) {
        return ea::ErrorCode::kLengthMismatch;
    }
{% for s in msg.signals %}
{{ m.encode_signal(s, 'in', s.raw_lo, s.raw_hi) }}
{%- endfor %}
    return ea::ok_result();
}
{% endfor %}

}  // namespace {{ ns }}
