{% for d in debounce %}
    // {{ d.name }}: consecutive {{ d.counts | join(' | ') }}, threshold {{ d.threshold }}{% if d.satisfies %}  [{{ d.satisfies | join(', ') }}]{% endif %}

    counters_[k{{ d.cname }}] = ({% for c in d.counts %}c == CycleCondition::k{{ c | camel }}{% if not loop.last %} || {% endif %}{% endfor %})
        ? ea::sat_inc(counters_[k{{ d.cname }}])
        : static_cast<std::uint16_t>(0U);
{% endfor %}
}

