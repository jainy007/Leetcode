void {{ component.name }}::publish_status() noexcept {
    {{ status.message.name }} msg{};
{% for f in status.fields %}
{% if f.source == 'state' %}
    msg.{{ f.signal.name }} = static_cast<double>(static_cast<std::uint8_t>(state_));
{% elif f.source == 'qualifier' %}
    msg.{{ f.signal.name }} = static_cast<double>(static_cast<std::uint8_t>(out_.qualifier));
{% elif f.source == 'alive_counter' %}
    alive_counter_ = (alive_counter_ + 1U) % {{ f.modulo }}U;  // protocol counter, wraps by definition
    msg.{{ f.signal.name }} = static_cast<double>(alive_counter_);
{% elif f.source == 'e2e_error_count' %}
    msg.{{ f.signal.name }} = static_cast<double>((e2e_error_count_ < {{ f.saturate }}U) ? e2e_error_count_ : {{ f.saturate }}U);
{% else %}
    msg.{{ f.signal.name }} = out_.data.{{ f.input_signal }};
{% endif %}
{% endfor %}
    // Ranges are proven compatible by the generator (GEN-046); a failure is a contract violation.
    const ea::Result<void> r = encode_{{ status.message.snake }}(msg, ea::ByteSpan(status_.data(), status_.size()));
    EA_ASSERT(r.ok());
}
{% endif %}

void {{ component.name }}::step(ea::ConstByteSpan frame) noexcept {
    {{ input.name }} decoded{};
    const CycleCondition c = classify(frame, decoded);
{% if status %}
{% for f in status.fields if f.source == 'e2e_error_count' %}
    if (c == CycleCondition::kE2eError) {
        e2e_error_count_ = ea::sat_inc(e2e_error_count_);
    }
{% endfor %}
{% endif %}
    update_debounce(c);
    transition();

    out_.state = state_;
    out_.condition = c;
    const bool valid_state = {% for s in valid_output_states %}(state_ == State::k{{ s | camel }}){% if not loop.last %} || {% endif %}{% endfor %};
    if (valid_state && c == CycleCondition::kValid) {
        out_.qualifier = Qualifier::kValid;
        out_.data = decoded;
    } else {
        out_.qualifier = Qualifier::kInvalid;  // last valid data is kept, never overwritten by unchecked data
    }
{% if status %}
    publish_status();
{% endif %}
    heartbeat_.beat();
}

