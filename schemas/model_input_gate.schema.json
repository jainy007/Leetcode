{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ea/model_input_gate.schema.json",
  "title": "Model for pattern input_gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pattern", "component", "inputs", "messages", "gate", "task"],
  "properties": {
    "schema_version": {"const": 1},
    "pattern": {"const": "input_gate"},
    "component": {"$ref": "common.schema.json#/$defs/component"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "features"],
      "properties": {
        "requirements": {"$ref": "common.schema.json#/$defs/relpath"},
        "features": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/relpath"}},
        "dbc": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/relpath"}}
      }
    },
    "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "debounce", "state_machine"],
      "properties": {
        "input": {"$ref": "common.schema.json#/$defs/type_name"},
        "status_output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message", "map"],
          "properties": {
            "message": {"$ref": "common.schema.json#/$defs/type_name"},
            "satisfies": {"$ref": "common.schema.json#/$defs/req_refs"},
            "map": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^(state|qualifier|alive_counter|e2e_error_count|input\\.[a-z][a-z0-9_]*)$"
              }
            }
          }
        },
        "debounce": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "counts", "threshold"],
            "properties": {
              "name": {"$ref": "common.schema.json#/$defs/identifier"},
              "counts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["valid", "e2e_error", "range_error", "missing"]}
              },
              "threshold": {"type": "integer", "minimum": 1, "maximum": 65535},
              "satisfies": {"$ref": "common.schema.json#/$defs/req_refs"}
            }
          }
        },
        "state_machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial", "states", "transitions", "valid_output_states"],
          "properties": {
            "initial": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "states": {
              "type": "array",
              "minItems": 2,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
            },
            "latched": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "valid_output_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "satisfies": {"$ref": "common.schema.json#/$defs/req_refs"},
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "on"],
                "properties": {
                  "from": {"type": "string"},
                  "to": {"type": "string"},
                  "on": {"$ref": "common.schema.json#/$defs/identifier"},
                  "satisfies": {"$ref": "common.schema.json#/$defs/req_refs"}
                }
              }
            }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "period_ms", "wcet_budget_us", "fifo_priority", "cpu_mask"],
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/identifier", "maxLength": 15},
        "period_ms": {"type": "integer", "minimum": 1, "maximum": 10000},
        "wcet_budget_us": {"type": "integer", "minimum": 1},
        "fifo_priority": {"type": "integer", "minimum": 0, "maximum": 99},
        "cpu_mask": {"type": "integer", "minimum": 0},
        "satisfies": {"$ref": "common.schema.json#/$defs/req_refs"}
      }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "transport", "payload_length", "signals"],
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/type_name"},
        "transport": {"enum": ["someip", "can"]},
        "someip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service_id", "event_id", "interface_version"],
          "properties": {
            "service_id": {"type": "integer", "minimum": 0, "maximum": 65535},
            "event_id": {"type": "integer", "minimum": 32768, "maximum": 65535},
            "interface_version": {"type": "integer", "minimum": 0, "maximum": 255}
          }
        },
        "can_id": {"type": "integer", "minimum": 0, "maximum": 536870911},
        "payload_length": {"type": "integer", "minimum": 1, "maximum": 4096},
        "e2e": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "data_id", "offset", "max_delta_counter"],
          "properties": {
            "profile": {"const": "P4"},
            "data_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "offset": {"type": "integer", "minimum": 0},
            "max_delta_counter": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "satisfies": {"$ref": "common.schema.json#/$defs/req_refs"},
        "signals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signal"}}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "factor", "offset", "min", "max", "unit"],
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/identifier"},
        "byte_offset": {"type": "integer", "minimum": 0},
        "type": {"enum": ["uint8", "int8", "uint16", "int16", "uint32", "int32"]},
        "start_bit": {"type": "integer", "minimum": 0},
        "length": {"type": "integer", "minimum": 1, "maximum": 32},
        "byte_order": {"enum": ["little_endian", "big_endian"]},
        "signed": {"type": "boolean"},
        "factor": {"type": "number", "exclusiveMinimum": 0},
        "offset": {"type": "number"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "unit": {"type": "string", "maxLength": 16},
        "sil_default": {"type": "number"},
        "satisfies": {"$ref": "common.schema.json#/$defs/req_refs"}
      },
      "oneOf": [
        {"required": ["byte_offset", "type"], "not": {"anyOf": [{"required": ["start_bit"]}, {"required": ["length"]}, {"required": ["byte_order"]}, {"required": ["signed"]}]}},
        {"required": ["start_bit", "length", "byte_order", "signed"], "not": {"anyOf": [{"required": ["byte_offset"]}, {"required": ["type"]}]}}
      ]
    }
  }
}
