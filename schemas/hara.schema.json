{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ea/hara.schema.json",
  "title": "Hazard analysis and risk assessment (ISO 26262-3) of a can_system item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item",
    "assumptions",
    "hazards",
    "hazardous_events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "item": {
      "$ref": "common.schema.json#/$defs/type_name"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A-[0-9]{2}$"
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "ftti_defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "hazards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "guide_word",
          "function",
          "malfunction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^H-[A-Z0-9]+-[0-9]{2}$"
          },
          "guide_word": {
            "enum": [
              "no",
              "more",
              "less",
              "unintended",
              "reverse",
              "stuck",
              "early",
              "late"
            ]
          },
          "function": {
            "type": "string"
          },
          "malfunction": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "hazardous_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hazard",
          "situation",
          "severity",
          "exposure",
          "controllability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HE-[A-Z0-9]+-[0-9]{2}$"
          },
          "hazard": {
            "type": "string"
          },
          "situation": {
            "type": "string",
            "minLength": 10
          },
          "severity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "rationale"
            ],
            "properties": {
              "class": {
                "enum": [
                  "S0",
                  "S1",
                  "S2",
                  "S3"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 20
              }
            }
          },
          "exposure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "rationale"
            ],
            "properties": {
              "class": {
                "enum": [
                  "E0",
                  "E1",
                  "E2",
                  "E3",
                  "E4"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 20
              }
            }
          },
          "controllability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "rationale"
            ],
            "properties": {
              "class": {
                "enum": [
                  "C0",
                  "C1",
                  "C2",
                  "C3"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 20
              }
            }
          },
          "safety_goal": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$"
          },
          "ftti": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "situations"
            ],
            "properties": {
              "model": {
                "enum": [
                  "rear_end_by_follower",
                  "approach_with_accel"
                ]
              },
              "situations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
