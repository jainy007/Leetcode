{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ea/fta.schema.json",
  "title": "Qualitative fault tree analysis of the safety goals of a can_system item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "elements",
    "events",
    "gates",
    "trees"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "elements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asil",
          "text"
        ],
        "properties": {
          "asil": {
            "type": "string",
            "pattern": "^(QM|A|B|C|D)(\\((A|B|C|D)\\))?$"
          },
          "text": {
            "type": "string"
          },
          "node": {
            "enum": [
              "controller",
              "monitor"
            ]
          }
        }
      }
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element",
          "text"
        ],
        "properties": {
          "element": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/gate"
      }
    },
    "trees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "safety_goal",
          "top",
          "gate"
        ],
        "properties": {
          "safety_goal": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$"
          },
          "top": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "and": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/child"
          }
        },
        "or": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/child"
          }
        }
      }
    },
    "child": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/gate"
        }
      ]
    }
  }
}
