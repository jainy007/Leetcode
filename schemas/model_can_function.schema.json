{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ea/model_can_function.schema.json",
  "title": "Model for pattern can_function (CAN-in/CAN-out vehicle function with a feature plug-in)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pattern",
    "feature",
    "component",
    "inputs",
    "cycle_ms",
    "rx",
    "tx",
    "bindings",
    "logic",
    "calibration"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pattern": {
      "const": "can_function"
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "component": {
      "$ref": "common.schema.json#/$defs/component"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "features",
        "dbc"
      ],
      "properties": {
        "requirements": {
          "$ref": "common.schema.json#/$defs/relpath"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/relpath"
          }
        },
        "dbc": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/relpath"
          }
        }
      }
    },
    "cycle_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "rx": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "period_ms",
          "timeout_ms",
          "e2e"
        ],
        "properties": {
          "message": {
            "$ref": "common.schema.json#/$defs/type_name"
          },
          "period_ms": {
            "type": "integer",
            "minimum": 1
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "e2e": {
            "$ref": "#/$defs/e2e"
          },
          "satisfies": {
            "$ref": "common.schema.json#/$defs/req_refs"
          }
        }
      }
    },
    "tx": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "e2e"
        ],
        "properties": {
          "message": {
            "$ref": "common.schema.json#/$defs/type_name"
          },
          "e2e": {
            "$ref": "#/$defs/e2e"
          },
          "satisfies": {
            "$ref": "common.schema.json#/$defs/req_refs"
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*\\.[A-Za-z][A-Za-z0-9_]*$"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "logic": {
      "$ref": "#/$defs/traced"
    },
    "calibration": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              }
            ]
          },
          "satisfies": {
            "$ref": "common.schema.json#/$defs/req_refs"
          }
        }
      }
    }
  },
  "$defs": {
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_id",
        "crc",
        "counter",
        "max_delta_counter"
      ],
      "properties": {
        "data_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "crc": {
          "type": "string"
        },
        "counter": {
          "type": "string"
        },
        "max_delta_counter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        }
      }
    },
    "traced": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "satisfies": {
          "$ref": "common.schema.json#/$defs/req_refs"
        }
      }
    }
  }
}
