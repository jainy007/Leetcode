{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ea/projects.schema.json",
  "title": "Generator project list",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": {"const": 1},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "model", "output"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "model": {"$ref": "common.schema.json#/$defs/relpath"},
          "output": {"$ref": "common.schema.json#/$defs/relpath"}
        }
      }
    }
  }
}
