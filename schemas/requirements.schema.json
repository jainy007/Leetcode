{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ea/requirements.schema.json",
  "title": "Requirements (EARS)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "component": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "asil",
          "ears",
          "text",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$"
          },
          "asil": {
            "type": "string",
            "pattern": "^(QM|A|B|C|D)(\\((A|B|C|D)\\))?$",
            "description": "ASIL, optionally decomposed as X(Y) per ISO 26262-9 clause 5 (e.g. B(D))"
          },
          "ears": {
            "enum": [
              "ubiquitous",
              "event",
              "state",
              "unwanted",
              "optional"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "sil",
                "hil",
                "review",
                "analysis"
              ]
            }
          }
        }
      }
    }
  }
}
