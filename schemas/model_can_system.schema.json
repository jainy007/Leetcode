{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ea/model_can_system.schema.json",
  "title": "Model for pattern can_system (decomposed ASIL D function: controller + monitor + actuator AoU)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pattern",
    "component",
    "inputs",
    "nodes",
    "actuator",
    "safety_goals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pattern": {
      "const": "can_system"
    },
    "component": {
      "$ref": "common.schema.json#/$defs/component"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "features"
      ],
      "properties": {
        "requirements": {
          "$ref": "common.schema.json#/$defs/relpath"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/relpath"
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller",
        "monitor"
      ],
      "properties": {
        "controller": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "monitor": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      }
    },
    "actuator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reaction_ms"
      ],
      "properties": {
        "reaction_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Fault reaction time of the actuator ECU from receiving the monitor's verdict (assumption of use)"
        },
        "satisfies": {
          "$ref": "common.schema.json#/$defs/req_refs"
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "satisfies"
      ],
      "properties": {
        "satisfies": {
          "$ref": "common.schema.json#/$defs/req_refs"
        }
      }
    },
    "safety_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "ftti_ms",
          "mechanisms"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$"
          },
          "ftti_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "mechanisms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/identifier"
            }
          }
        }
      }
    }
  }
}
