{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ea/steps.schema.json",
  "title": "Gherkin step catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pattern", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "pattern": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "keywords", "pattern", "cpp"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+-S[0-9]{2,3}$"},
          "keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["given", "when", "then"]}},
          "pattern": {"type": "string", "pattern": "^\\^.*\\$$"},
          "types": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^(int|number|number_or_nan|ref:[a-z_]+|enum:\\[[A-Za-z_, ]+\\])$"}
          },
          "cpp": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
