{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-host",
      "displayName": "Linux host (SIL, CI)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-host-asan",
      "inherits": "linux-host",
      "cacheVariables": { "EA_SANITIZER": "address;undefined" }
    },
    {
      "name": "linux-host-tsan",
      "inherits": "linux-host",
      "cacheVariables": { "EA_SANITIZER": "thread" }
    },
    {
      "name": "linux-host-coverage",
      "inherits": "linux-host",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "EA_COVERAGE": "ON"
      }
    },
    {
      "name": "linux-aarch64-rt",
      "inherits": "linux-host",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-aarch64-rt.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "EA_BUILD_TESTS": "OFF" }
    },
    {
      "name": "driveos",
      "inherits": "linux-aarch64-rt",
      "toolchainFile": "${sourceDir}/cmake/toolchains/driveos-aarch64.cmake",
      "cacheVariables": { "EA_GPU_CUDA": "ON" }
    },
    {
      "name": "qnx-aarch64",
      "inherits": "linux-aarch64-rt",
      "toolchainFile": "${sourceDir}/cmake/toolchains/qnx-aarch64.cmake"
    }
  ],
  "buildPresets": [
    { "name": "linux-host", "configurePreset": "linux-host" },
    { "name": "linux-host-asan", "configurePreset": "linux-host-asan" },
    { "name": "linux-host-tsan", "configurePreset": "linux-host-tsan" },
    { "name": "linux-host-coverage", "configurePreset": "linux-host-coverage" }
  ],
  "testPresets": [
    { "name": "linux-host", "configurePreset": "linux-host", "output": { "outputOnFailure": true } },
    { "name": "linux-host-asan", "configurePreset": "linux-host-asan", "output": { "outputOnFailure": true } },
    { "name": "linux-host-tsan", "configurePreset": "linux-host-tsan", "output": { "outputOnFailure": true } },
    { "name": "linux-host-coverage", "configurePreset": "linux-host-coverage", "output": { "outputOnFailure": true } }
  ]
}
